---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  locale?: 'th' | 'en';
  titleEn?: string;
  descriptionEn?: string;
  lockedLocale?: 'th' | 'en';
  localePaths?: { th: string; en: string };
}
const { title, description = 'งานเขียนของ Breeze', locale = 'th', titleEn, descriptionEn, lockedLocale, localePaths } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;1,400&family=Sarabun:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body data-title-th={title} data-title-en={titleEn || title} data-description-th={description} data-description-en={descriptionEn || description} data-locked-locale={lockedLocale}>
    <header>
      <nav>
        <a href="/" class="site-title">Breeze's Writing</a>
        <div class="nav-links">
          <a href="/" class="nav-link" data-th="งานเขียน" data-en="Writing">งานเขียน</a>
          <a href="/music" class="nav-link" data-th="บทเพลง" data-en="Music">บทเพลง</a>
          <a href="/about" class="nav-link" data-th="เกี่ยวกับ" data-en="About">เกี่ยวกับ</a>
        </div>
        <div class="global-language-switch" role="group" aria-label="Language">
          {localePaths ? (
            <>
              <a href={localePaths.th} data-language="th" aria-current={locale === 'th' ? 'page' : undefined}>ไทย</a>
              <a href={localePaths.en} data-language="en" aria-current={locale === 'en' ? 'page' : undefined}>English</a>
            </>
          ) : (
            <>
              <button type="button" data-language="th" aria-pressed="true">ไทย</button>
              <button type="button" data-language="en" aria-pressed="false">English</button>
            </>
          )}
        </div>
      </nav>
    </header>
    <main transition:animate="fade">
      <slot />
    </main>
    <footer>
      <p data-th={`© ${new Date().getFullYear()} Breeze's Writing`} data-en={`© ${new Date().getFullYear()} Breeze's Writing`}>© {new Date().getFullYear()} Breeze's Writing</p>
    </footer>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --color-bg: #faf9f6;
    --color-surface: #f3f1ec;
    --color-text: #1e1c1a;
    --color-text-soft: #3a3733;
    --color-muted: #7a756e;
    --color-accent: #7c5c3a;
    --color-accent-hover: #5e4429;
    --color-border: #ddd9d2;
    --color-border-light: #eae7e1;
    --font-body: 'Sarabun', 'Helvetica Neue', sans-serif;
    --font-heading: 'Lora', 'Georgia', serif;
    --max-width: 680px;
    --ease: cubic-bezier(0.4, 0, 0.2, 1);
  }

  html {
    font-size: 18px;
    scroll-behavior: smooth;
    overflow-x: hidden;
  }

  body {
    font-family: var(--font-body);
    background-color: var(--color-bg);
    color: var(--color-text);
    line-height: 1.8;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    animation: fadeIn 0.4s ease both;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  header {
    padding: 1.4rem 2rem;
    border-bottom: 1px solid var(--color-border-light);
    position: sticky;
    top: 0;
    background-color: rgba(250, 249, 246, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 100;
  }

  nav {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem;
  }

  .site-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 500;
    font-style: italic;
    color: var(--color-accent);
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: color 0.2s var(--ease);
  }

  .site-title:hover {
    color: var(--color-accent-hover);
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .global-language-switch { display: flex; align-items: center; gap: 0.2rem; flex-shrink: 0; margin-left: 0.25rem; }
  .global-language-switch button, .global-language-switch a { border: 1px solid transparent; border-radius: 999px; background: transparent; color: var(--color-muted); padding: 0.25rem 0.55rem; cursor: pointer; font: inherit; font-size: 0.72rem; white-space: nowrap; }
  .global-language-switch button[aria-pressed="true"], .global-language-switch a[aria-current="page"] { background: var(--color-accent); border-color: var(--color-accent); color: white; }

  .nav-link {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--color-text-soft);
    text-decoration: none;
    letter-spacing: 0.02em;
    padding: 0.4rem 0.9rem;
    border-radius: 6px;
    transition: color 0.2s var(--ease), background-color 0.2s var(--ease);
    position: relative;
  }

  .nav-link:hover {
    color: var(--color-accent);
    background-color: rgba(124, 92, 58, 0.07);
    text-decoration: none;
  }

  main {
    flex: 1;
    max-width: var(--max-width);
    width: 100%;
    margin: 0 auto;
    padding: 3.5rem 2rem 4rem;
  }

  footer {
    text-align: center;
    padding: 2rem;
    color: var(--color-muted);
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    border-top: 1px solid var(--color-border-light);
  }

  a {
    color: var(--color-accent);
    text-decoration: none;
  }

  a:hover {
    text-decoration: none;
  }

  @media (max-width: 580px) {
    main {
      padding: 2.5rem 1.4rem 3rem;
    }
    header {
      padding: 1rem 1.4rem;
    }
    .nav-links {
      gap: 0.15rem;
      margin-left: auto;
    }
    .nav-link {
      font-size: 0.82rem;
      padding: 0.35rem 0.65rem;
    }
    nav { display: grid; grid-template-columns: 1fr auto; row-gap: 0.35rem; }
    .site-title { grid-column: 1 / -1; }
    .nav-links { grid-column: 1; margin-left: 0; }
    .global-language-switch { grid-column: 2; grid-row: 2; margin-left: 0; }
  }
</style>

<script>
  const languageStorageKey = 'writing-language';

  function applySiteLanguage(language: 'th' | 'en') {
    document.documentElement.lang = language;
    document.querySelectorAll<HTMLElement>('[data-th][data-en]').forEach((element) => {
      element.textContent = element.dataset[language] || '';
    });
    document.querySelectorAll<HTMLAnchorElement>('[data-th-href][data-en-href]').forEach((link) => {
      link.href = link.dataset[language === 'en' ? 'enHref' : 'thHref'] || link.href;
    });
    document.querySelectorAll<HTMLElement>('[data-th-aria-label][data-en-aria-label]').forEach((element) => {
      element.setAttribute('aria-label', element.dataset[language === 'en' ? 'enAriaLabel' : 'thAriaLabel'] || '');
    });
    document.querySelectorAll<HTMLImageElement>('[data-th-alt][data-en-alt]').forEach((image) => {
      image.alt = image.dataset[language === 'en' ? 'enAlt' : 'thAlt'] || '';
    });
    document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-th-placeholder][data-en-placeholder]').forEach((element) => {
      element.placeholder = element.dataset[language === 'en' ? 'enPlaceholder' : 'thPlaceholder'] || '';
    });
    document.querySelectorAll<HTMLElement>('[data-language-block]').forEach((element) => {
      element.hidden = element.dataset.languageBlock !== language;
    });

    const body = document.body;
    document.title = body.dataset[language === 'en' ? 'titleEn' : 'titleTh'] || document.title;
    const description = document.querySelector<HTMLMetaElement>('meta[name="description"]');
    if (description) description.content = body.dataset[language === 'en' ? 'descriptionEn' : 'descriptionTh'] || description.content;

    document.querySelectorAll<HTMLButtonElement>('.global-language-switch button').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.language === language));
    });
    document.querySelectorAll<HTMLAnchorElement>('.global-language-switch a[data-language]').forEach((link) => {
      link.setAttribute('aria-current', link.dataset.language === language ? 'page' : 'false');
    });
    localStorage.setItem(languageStorageKey, language);
    document.dispatchEvent(new CustomEvent('site-language-change', { detail: { language } }));
  }

  function initializeSiteLanguage() {
    const body = document.body;
    const lockedLocale = body.dataset.lockedLocale as 'th' | 'en' | undefined;
    const savedLocale = localStorage.getItem(languageStorageKey) as 'th' | 'en' | null;
    applySiteLanguage(lockedLocale || savedLocale || 'th');
    document.querySelectorAll<HTMLButtonElement>('.global-language-switch button').forEach((button) => {
      button.onclick = () => applySiteLanguage(button.dataset.language === 'en' ? 'en' : 'th');
    });
  }

  document.addEventListener('astro:page-load', initializeSiteLanguage);
  initializeSiteLanguage();
</script>
