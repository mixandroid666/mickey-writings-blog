---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import profileImage from '../assets/88426601_10214395664678959_2333448950163439616_n.jpg';
---

<Layout title="เกี่ยวกับ Breeze — Breeze's Writing" description="ทำความรู้จักกับ Breeze ผู้เขียนบทความและงานเขียนเชิงปรัชญาชีวิต">
  <section class="about-hero">
    <div class="profile-image-wrapper">
      <Image src={profileImage} alt="Breeze — ผู้เขียน" class="profile-image" />
    </div>
    <div class="hero-text">
      <p class="hero-label">ผู้เขียน</p>
      <h1>Breeze</h1>
      <p class="hero-tagline">นักเขียน · นักคิด · ผู้แสวงหาความหมาย</p>
    </div>
  </section>

  <section class="about-content">
    <div class="about-block">
      <h2>เกี่ยวกับข้าพเจ้า</h2>
      <p>
        ข้าพเจ้าเป็นผู้ที่หลงใหลในการเขียนและการครุ่นคิด งานเขียนของข้าพเจ้ามักเกิดจากการสังเกตชีวิตรอบตัว
        ตั้งแต่ความเงียบในยามค่ำคืน ไปจนถึงความซับซ้อนของจิตใจมนุษย์ ข้าพเจ้าเชื่อว่าการเขียนคือการเดินทาง
        เข้าสู่ส่วนลึกของตัวเอง และบางครั้งก็พาเราไปยังที่ที่เราไม่คาดคิด
      </p>
      <p>
        การเขียนเป็นเหมือนลมหายใจสำหรับข้าพเจ้า เป็นวิธีการทำความเข้าใจโลกและตัวเอง
        ทุกตัวอักษรที่เขียนลงไปคือความพยายามที่จะจับต้องสิ่งที่จับต้องไม่ได้ — ความรู้สึก ความคิด
        และแก่นแท้ของการมีชีวิตอยู่
      </p>
    </div>

    <div class="about-block">
      <h2>แรงบันดาลใจ</h2>
      <p>
        ข้าพเจ้าได้รับแรงบันดาลใจจากหลายสิ่ง ไม่ว่าจะเป็นวรรณกรรมคลาสสิก ปรัชญาตะวันออก
        หรือแม้แต่บทสนทนาเล็กๆ ในชีวิตประจำวัน ข้าพเจ้าเชื่อว่าทุกสิ่งรอบตัวล้วนมีเรื่องราวที่รอให้ถูกค้นพบ
      </p>
    </div>

    <div class="interests-section">
      <h2>สิ่งที่สนใจ</h2>
      <div class="interests-grid">
        <div class="interest-card">
          <span class="interest-icon">✍️</span>
          <h3>การเขียน</h3>
          <p>สำรวจความคิดผ่านตัวอักษร เขียนเพื่อเข้าใจโลกและตัวเอง</p>
        </div>
        <div class="interest-card">
          <span class="interest-icon">📚</span>
          <h3>วรรณกรรมและการดนตรี</h3>
          <p>อ่านทั้งวรรณกรรมไทยและต่างประเทศ และหาแรงบันดาลใจจากเสียงดนตรี</p>
        </div>
        <div class="interest-card">
          <span class="interest-icon">🧘</span>
          <h3>ปรัชญา</h3>
          <p>ศึกษาปรัชญาชีวิตและคำสอนที่ช่วยให้เข้าใจธรรมชาติของจิตใจ</p>
        </div>
        <div class="interest-card">
          <span class="interest-icon">🌿</span>
          <h3>ธรรมชาติ</h3>
          <p>หาความสงบจากธรรมชาติ และค้นหาแรงบันดาลใจจากความเงียบ</p>
        </div>
        <div class="interest-card">
          <span class="interest-icon">💎</span>
          <h3>ความจริง</h3>
          <p>แสวงหาความจริงที่ซ่อนอยู่ภายใต้สิ่งที่ปรากฏ และตั้งคำถามกับสิ่งที่คนส่วนใหญ่ยอมรับ</p>
        </div>
        <div class="interest-card">
          <span class="interest-icon">🚶</span>
          <h3>การเดินทาง</h3>
          <p>เดินทางเพื่อค้นพบมุมมองใหม่ ทั้งการเดินทางภายนอกและการเดินทางภายในจิตใจ</p>
        </div>
      </div>
    </div>

    <div class="about-block contact-block">
      <h2>ติดต่อ</h2>
      <p>
        หากคุณต้องการพูดคุย แลกเปลี่ยนความคิดเห็น หรือเพียงแค่ทักทาย
        สามารถติดต่อข้าพเจ้าได้ทางอีเมล
      </p>
      <a class="email-contact" href="mailto:major_seventh@live.com">major_seventh@live.com</a>
    </div>
  </section>

  <footer class="about-footer">
    <a href="/" class="back-link">← กลับไปหน้าหลัก</a>
  </footer>
</Layout>

<style>
  /* Hero Section */
  .about-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 3.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border-light);
  }

  .profile-image-wrapper {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 1.8rem;
    border: 3px solid var(--color-border-light);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }

  .profile-image-wrapper:hover {
    transform: scale(1.04);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
  }

  .profile-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-text {
    max-width: 400px;
  }

  .hero-label {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.82rem;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
    opacity: 0.85;
  }

  h1 {
    font-family: var(--font-heading);
    font-size: 2.4rem;
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 0.6rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .hero-tagline {
    color: var(--color-muted);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    line-height: 1.6;
  }

  /* Content Sections */
  .about-content {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .about-block h2 {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 1rem;
    position: relative;
    padding-bottom: 0.6rem;
  }

  .about-block h2::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 28px;
    height: 2px;
    background-color: var(--color-accent);
    border-radius: 2px;
    opacity: 0.6;
  }

  .about-block p {
    color: var(--color-text-soft);
    font-size: 0.95rem;
    line-height: 2;
    margin-bottom: 1rem;
  }

  .about-block p:last-child {
    margin-bottom: 0;
  }

  /* Interests Section */
  .interests-section h2 {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 1.4rem;
    position: relative;
    padding-bottom: 0.6rem;
  }

  .interests-section h2::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 28px;
    height: 2px;
    background-color: var(--color-accent);
    border-radius: 2px;
    opacity: 0.6;
  }

  .interests-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .interest-card {
    padding: 1.4rem;
    background-color: var(--color-surface);
    border-radius: 10px;
    border: 1px solid var(--color-border-light);
    transition: border-color 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .interest-card:hover {
    border-color: var(--color-border);
    transform: translateY(-2px);
  }

  .interest-icon {
    font-size: 1.5rem;
    display: block;
    margin-bottom: 0.7rem;
  }

  .interest-card h3 {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 0.4rem;
  }

  .interest-card p {
    color: var(--color-muted);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  /* Contact */
  .contact-block p {
    margin-bottom: 1.4rem;
  }

  .email-contact {
    display: inline-block;
    color: var(--color-text);
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border-light);
    border-radius: 8px;
    background-color: var(--color-surface);
    text-decoration: none;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .email-contact:hover {
    color: var(--color-accent);
    border-color: var(--color-border);
  }

  /* Footer */
  .about-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border-light);
  }

  .back-link {
    display: inline-block;
    font-size: 0.82rem;
    color: var(--color-muted);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 0.2s var(--ease);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  /* Responsive */
  @media (max-width: 580px) {
    .profile-image-wrapper {
      width: 130px;
      height: 130px;
    }

    h1 {
      font-size: 1.9rem;
    }

    .interests-grid {
      grid-template-columns: 1fr;
    }

  }
</style>
